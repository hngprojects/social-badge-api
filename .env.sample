# ── Core ──────────────────────────────────────────────────────────────────────
PROJECT_NAME=social-badge-api
ENVIRONMENT=local                   # local | staging | production
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
APP_DOMAIN=social-badge.hng14.com

# ── Database ──────────────────────────────────────────────────────────────────
# Driver must be postgresql+asyncpg
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/social_badge

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256                     # HS256 | HS384 | HS512

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
VERIFICATION_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# ── Cookies ───────────────────────────────────────────────────────────────────
COOKIE_SECURE=False                 # Set True in production (HTTPS only)
COOKIE_SAMESITE=lax                 # lax | strict | none
ACCESS_COOKIE=access_token
REFRESH_COOKIE=refresh_token
COOKIE_DOMAIN=                      # Leave blank for localhost; set domain in production

# ── Rate limiting / account lockout ──────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_WINDOW=900                  # seconds (15 minutes)

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated or JSON array of allowed origins.
ALLOWED_ORIGINS=http://localhost:3000

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ── Email subjects ────────────────────────────────────────────────────────────
CONTACT_RECIPIENT_EMAIL=
CONTACT_NOTIFICATION_SUBJECT=New Contact Form Submission — Flare Tag
CONTACT_CONFIRMATION_SUBJECT=We received your message — Flare Tag
NEWSLETTER_WELCOME_SUBJECT=You're subscribed to the Flare Tag newsletter!
VERIFICATION_SUBJECT=Verify your Flare Tag account
ACCOUNT_LOCK_SUBJECT=Your Flare Tag account has been locked
PASSWORD_RESET_SUBJECT=Reset your Flare Tag password
ONBOARDING_SUBJECT=Welcome to Flare Tag! Let's ship.
SECURITY_ALERT_SUBJECT=Security alert — all sessions have been terminated

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOGO_FOLDER=template-logos

# ── Misc ──────────────────────────────────────────────────────────────────────
MAX_CONTENT_BODY_SIZE=10485760      # bytes (10 MB)
REFRESH_REUSE_GRACE_SECONDS=5
