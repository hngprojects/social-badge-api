  "item": [
    {
      "name": "Badge Generation",
      "item": [
        {
          "name": "Generate Badge",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has job_id and status', function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData.job_id).to.exist;",
                  "    pm.expect(jsonData.status).to.equal('queued');",
                  "    pm.collectionVariables.set('job_id', jsonData.job_id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"template_id\": \"44e4c525-806a-4e56-97e5-77e99fdc3447\",\n  \"participant_name\": \"John Doe\",\n  \"photo_url\": \"https://res.cloudinary.com/dioc2tnrm/image/upload/v1757737030/menu_images/20250913041710_337f67a8a07a48bfb61239975f61fdb7_OIP%20%2863%29.jpeg.jpg\"\n}"
            },
            "url": {
