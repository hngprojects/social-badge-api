        {
          "name": "Get Job Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Job has expected fields', function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData.job_id).to.exist;",
                  "    pm.expect(jsonData.status).to.exist;",
                  "    pm.expect(jsonData.badge_image_url).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/badges/jobs/{{job_id}}",
              "host": ["{{base_url}}"],
