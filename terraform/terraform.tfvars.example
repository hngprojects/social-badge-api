# Copy this file to terraform.tfvars and fill in real values.
# Never commit terraform.tfvars to git — it contains secrets.

# ── AWS infrastructure ─────────────────────────────────────────────────────────
aws_region           = "us-east-1"
instance_type        = "t3.large"   # monitoring server (Prometheus + Loki + Grafana + Tempo)
ssh_public_key_path  = "~/.ssh/id_ed25519.pub"
ssh_private_key_path = "~/.ssh/id_ed25519"

# One CIDR per engineer — use /32 for individual IPs
# run `curl https://checkip.amazonaws.com` to get your current IP
engineer_ips = [
  "203.0.113.1/32",  # Engineer 1
  "203.0.113.2/32",  # Engineer 2
]

# ── Existing app server ───────────────────────────────────────────────────────
# Terraform will SSH into this server and run scripts/app-agent.sh.
app_server_ssh_host            = "198.51.100.10"
app_server_ssh_user            = "ubuntu"
app_server_source_cidr         = "198.51.100.10/32"
app_server_metrics_host        = "198.51.100.10"
app_server_app_port            = 8000
app_server_node_exporter_port  = 9100
app_server_app_log_file        = "/opt/social-badge-api/logs/app.log"
app_server_app_error_log_file  = "/opt/social-badge-api/logs/app_errors.log"

# ── Observability stack secrets ────────────────────────────────────────────────
slack_webhook_url      = "" # optional; leave empty if using email only
slack_channel          = "#social-badge-devops-alerts"
grafana_admin_password = "ChooseAStrongPassword123!"
duckdns_subdomain      = "adeshipo-lgtm"
duckdns_token          = "your-duckdns-token"
metrics_retention      = "15d"
logs_retention         = 360

# ── Alertmanager email alerts ─────────────────────────────────────────────────
alert_email_recipients = [
  "devops@example.com",
  "oncall@example.com",
]
smtp_smarthost      = "smtp.gmail.com:587"
smtp_from           = "alerts@example.com"
smtp_auth_username  = "alerts@example.com"
smtp_auth_password  = "smtp-app-password"
smtp_require_tls    = true
